# ===========================================
# SIMREKAP - Environment Configuration
# ===========================================
# Copy ini ke .env (atau .env.local) dan isi nilai yang sesuai.
# JANGAN PERNAH meng-commit file .env atau .env.local ke Git!
# ===========================================

# -------------------------------------------
# APPLICATION ENVIRONMENT & NETWORK
# -------------------------------------------
# Mode aplikasi: development / production
# Default: development
SIMRP_ENV=development

# Host IP tempat server backend mendengarkan request.
# Gunakan 127.0.0.1 untuk lokal, atau 0.0.0.0 jika di belakang Nginx / bind ke IP publik.
SIMRP_HOST=127.0.0.1

# Port HTTP backend Python
# Default: 8000
SIMRP_PORT=8000

# -------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------
# Path ke file SQLite database runtime
# Default: ./database/runtime/database.db
SIMRP_DB_PATH=./database/runtime/database.db

# -------------------------------------------
# SECURITY - PASSWORD HASHING
# -------------------------------------------
# Jumlah iterasi PBKDF2-HMAC-SHA256 untuk keamanan password.
# Default: 210000 (development), naikkan ke 600000+ untuk production.
SIMRP_PBKDF2_ITERATIONS=210000

# -------------------------------------------
# SECURITY - ADMIN CREDENTIALS
# -------------------------------------------
# Username login portal admin (/admin)
SIMRP_ADMIN_LOGIN_USERNAME=admin

# Password login portal admin.
# Kosongkan di development agar dibuat acak di database/runtime/dev_credentials.txt.
# Untuk production, wajib isi password unik & kuat (minimal 16 karakter).
SIMRP_ADMIN_LOGIN_PASSWORD=

# -------------------------------------------
# SECURITY - SESSION MANAGEMENT
# -------------------------------------------
# Masa berlaku token session dalam jam.
# Default: 168 (7 hari) untuk development, 24 jam untuk production.
SIMRP_SESSION_TTL_HOURS=24

# -------------------------------------------
# SECURITY - RATE LIMITING
# -------------------------------------------
# Durasi window rate limit dalam detik (default: 60)
SIMRP_RATE_LIMIT_WINDOW_SECONDS=60
# Batas maksimal request auth per window (login, signup, admin-login)
SIMRP_RATE_LIMIT_AUTH_MAX=10
# Batas maksimal request mutasi data per window (POST, PUT, DELETE)
SIMRP_RATE_LIMIT_MUTATION_MAX=120

# -------------------------------------------
# SECURITY - REQUEST LIMITS
# -------------------------------------------
# Ukuran maksimal request body dalam bytes (default: 8MB / 8388608)
SIMRP_MAX_BODY_BYTES=8388608

# -------------------------------------------
# SECURITY - OTP / VERIFIKASI NOMOR HP
# -------------------------------------------
# Provider OTP:
# - dev: untuk testing/demo lokal (devOtpCode dikembalikan di response JSON)
# - disabled: nonaktifkan endpoint OTP
# Production tidak boleh menggunakan provider=dev.
SIMRP_OTP_PROVIDER=dev
SIMRP_OTP_SECRET=
SIMRP_OTP_TTL_MINUTES=10
SIMRP_OTP_MAX_ATTEMPTS=5
SIMRP_OTP_REQUIRE_VERIFICATION=false

# -------------------------------------------
# CORS - ALLOWED ORIGINS
# -------------------------------------------
# Daftar origin frontend yang diizinkan dipisahkan koma.
# Contoh production: https://simrekap.surabaya.go.id
SIMRP_ALLOWED_ORIGINS=

# Set true jika backend berada di belakang trusted Reverse Proxy (Nginx) yang meneruskan header X-Forwarded-For.
SIMRP_TRUST_PROXY_HEADERS=false

# -------------------------------------------
# SECURITY - SEED DATA DEMO
# -------------------------------------------
# Set true untuk mengaktifkan data sampel demo awal pada database baru.
SIMRP_ENABLE_DEMO_SEED=false

# Password untuk akun-akun relawan/KSH/moderator demo.
# Kosongkan di development agar dibuat acak di database/runtime/dev_credentials.txt.
SIMRP_DEMO_PASSWORD=

# Password untuk akun admin bootstrap pertama kali saat DB kosong.
SIMRP_SEED_ADMIN_PASSWORD=

# -------------------------------------------
# FRONTEND - VITE CONFIGURATION
# -------------------------------------------
# API Base URL untuk dipanggil oleh Frontend React
# Prefix endpoint tetap: /make-server-32aa5c5c
VITE_API_BASE_URL=http://127.0.0.1:8000/make-server-32aa5c5c
